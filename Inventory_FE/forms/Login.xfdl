<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1"><Form id="Login" width="1440" height="960" titletext="Login" onload="onLoad">
<Layouts><Layout width="1440" height="960">
<Static id="staAuthCanvas" left="0" top="0" width="1440" height="960" text="" cssclass="authCanvas"/>
<Static id="staLogoMark" left="320" top="355" width="150" height="160" text="K" cssclass="authLogoMark"/>
<Static id="staBrandLarge" left="270" top="520" width="280" height="65" text="KANBAN" cssclass="authBrand"/>
<Static id="staSmallMark" left="993" top="277" width="48" height="51" text="K" cssclass="smallLogo"/>
<Static id="staHello" left="825" top="340" width="440" height="55" text="Log in to your account" cssclass="authTitle"/>
<Static id="staHint" left="825" top="391" width="440" height="28" text="Welcome back! Please enter your details." cssclass="muted"/>
<Static id="staEmail" left="825" top="442" width="360" height="23" text="Email" cssclass="fieldLabel"/>
<Edit id="edtEmail" left="825" top="470" width="360" height="45" cssclass="field" displaynulltext="Enter your email"/>
<Static id="staPassword" left="825" top="535" width="360" height="23" text="Password" cssclass="fieldLabel"/>
<Edit id="edtPassword" left="825" top="563" width="360" height="45" cssclass="field" password="true"/>
<CheckBox id="chkRemember" left="825" top="632" width="218" height="28" text="Remember for 30 days"/>
<Button id="btnForgot" left="1050" top="632" width="135" height="28" text="Forgot password" cssclass="link" onclick="onForgot"/>
<Button id="btnLogin" left="825" top="684" width="360" height="46" text="Sign in" cssclass="primary" onclick="onLogin"/>
<Static id="staSignUpHint" left="883" top="747" width="225" height="25" text="Don't have an account?" cssclass="muted"/>
<Button id="btnSignUp" left="1082" top="747" width="103" height="25" text="Sign up" cssclass="link" onclick="onSignUp"/>
</Layout></Layouts>
<Objects></Objects>
<Script type="xscript5.1"><![CDATA[include "lib::InventoryCommon.xjs";

this.onLoad = function() {};
this.onLogin = function() {
  var email = this.edtEmail.value, password = this.edtPassword.value;
  if (!this.gfnEmail(email)) return this.gfnMessage("Enter a valid email address.");
  if (this.gfnEmpty(password)) return this.gfnMessage("Password is required.");
  nexacro.getApplication().inventoryEmail = email;
  this.gfnNavigate("InventoryList");
};
this.onSignUp = function() { this.gfnNavigate("SignUp"); };
this.onForgot = function() { this.gfnMessage("Password recovery will be available with the authentication API."); };

]]></Script></Form></FDL>