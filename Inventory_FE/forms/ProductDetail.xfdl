<Objects><Dataset id="dsRequest"><ColumnInfo><Column id="ProductID" type="STRING" size="1024"/></ColumnInfo></Dataset><Dataset id="dsProduct"><ColumnInfo><Column id="ProductID" type="STRING" size="1024"/><Column id="ProductName" type="STRING" size="1024"/><Column id="Category" type="STRING" size="1024"/><Column id="BuyingPrice" type="STRING" size="1024"/><Column id="Quantity" type="STRING" size="1024"/><Column id="Unit" type="STRING" size="1024"/><Column id="ExpiryDate" type="STRING" size="1024"/><Column id="Threshold" type="STRING" size="1024"/><Column id="Supplier" type="STRING" size="1024"/><Column id="SupplierID" type="STRING" size="1024"/><Column id="ImageUrl" type="STRING" size="1024"/><Column id="Status" type="STRING" size="1024"/></ColumnInfo></Dataset><Dataset id="dsLogout"><ColumnInfo><Column id="SessionToken" type="STRING" size="1024"/></ColumnInfo></Dataset><Dataset id="dsProductDetail" onrowsetchanged="onProductDetailChanged"><ColumnInfo><Column id="ProductID" type="STRING" size="1024"/><Column id="ProductIDLabel" type="STRING" size="1024"/><Column id="ProductName" type="STRING" size="1024"/><Column id="Category" type="STRING" size="1024"/><Column id="BuyingPrice" type="STRING" size="1024"/><Column id="Quantity" type="STRING" size="1024"/><Column id="Unit" type="STRING" size="1024"/><Column id="ExpiryDate" type="STRING" size="1024"/><Column id="Threshold" type="STRING" size="1024"/><Column id="Supplier" type="STRING" size="1024"/><Column id="SupplierInfo" type="STRING" size="1024"/><Column id="SupplierID" type="STRING" size="1024"/><Column id="ImageUrl" type="STRING" size="1024"/><Column id="Status" type="STRING" size="1024"/><Column id="OverviewText" type="STRING" size="1024"/></ColumnInfo></Dataset><Dataset id="dsStockLocations"><ColumnInfo><Column id="Location" type="STRING" size="1024"/><Column id="Quantity" type="STRING" size="1024"/><Column id="Unit" type="STRING" size="1024"/><Column id="UpdatedAt" type="STRING" size="1024"/></ColumnInfo></Dataset><Dataset id="dsPurchases"><ColumnInfo><Column id="EventID" type="STRING" size="1024"/><Column id="Type" type="STRING" size="1024"/><Column id="QuantityChange" type="STRING" size="1024"/><Column id="Description" type="STRING" size="1024"/><Column id="CreatedAt" type="STRING" size="1024"/></ColumnInfo></Dataset><Dataset id="dsAdjustments"><ColumnInfo><Column id="EventID" type="STRING" size="1024"/><Column id="Type" type="STRING" size="1024"/><Column id="QuantityChange" type="STRING" size="1024"/><Column id="Description" type="STRING" size="1024"/><Column id="CreatedAt" type="STRING" size="1024"/></ColumnInfo></Dataset><Dataset id="dsHistory"><ColumnInfo><Column id="EventID" type="STRING" size="1024"/><Column id="Type" type="STRING" size="1024"/><Column id="QuantityChange" type="STRING" size="1024"/><Column id="Description" type="STRING" size="1024"/><Column id="CreatedAt" type="STRING" size="1024"/></ColumnInfo></Dataset><Dataset id="dsActivity" onrowsetchanged="onActivityChanged"><ColumnInfo><Column id="EventID" type="STRING" size="1024"/><Column id="Type" type="STRING" size="1024"/><Column id="QuantityChange" type="STRING" size="1024"/><Column id="Description" type="STRING" size="1024"/><Column id="CreatedAt" type="STRING" size="1024"/></ColumnInfo></Dataset></Objects>
<Script type="xscript5.1"><![CDATA[include "lib::InventoryCommon.xjs";
this.currentTab = "Overview";
this.onLoad = function() {
  this.onResponsiveSize();
  if (!nexacro.getApplication().sessionToken) return this.gfnNavigate("Login");
  var id = nexacro.getApplication().selectedProductId;
  if (this.gfnEmpty(id)) return this.gfnNavigate("InventoryList");
  this.gfnBindRecord(this.dsRequest, { ProductID: id });
  this.gfnTransaction("product-detail", "products/detail", "dsRequest=dsRequest",
    "dsProduct=dsProduct dsProductDetail=dsProductDetail dsStockLocations=dsStockLocations "
      + "dsPurchases=dsPurchases dsAdjustments=dsAdjustments dsHistory=dsHistory",
    "", "onProductDetailLoaded");
};
this.onResponsiveSize = function() {
  this.gfnResponsiveDetail(this.gfnResponsiveShell("ProductDetail", false));
};
this.onProductDetailLoaded = function(serviceId, errorCode, errorMessage) {
  if (errorCode < 0 || !this.dsProductDetail.rowcount) return this.gfnHandleApiError(errorCode, errorMessage);
  this.showTab("Overview");
};
this.onProductDetailChanged = function(obj, e) {
  if (e.reason !== nexacro.Dataset.REASON_ASSIGN && e.reason !== nexacro.Dataset.REASON_APPEND &&
      e.reason !== nexacro.Dataset.REASON_MERGE) return;
  this.showTab(this.currentTab || "Overview");
};
this.showTab = function(name) {
  this.currentTab = name;
  this.staTab.set_text(name);
  var tabs = ["Overview", "Purchases", "Adjustments", "History"];
  var compact = this.getOffsetWidth() < 920;
  var labels = compact ? ["Overview", "Purchases", "Adjust.", "History"] : tabs;
  for (var i = 0; i < tabs.length; i++) {
    this["btn" + tabs[i]].set_text(labels[i]);
    this["btn" + tabs[i]].set_cssclass(tabs[i] === name ? "tabActive" : "tab");
  }
  var source = name === "Purchases" ? this.dsPurchases
    : (name === "Adjustments" ? this.dsAdjustments : this.dsHistory);
  if (name === "Overview") source = this.dsHistory;
  this.dsActivity.copyData(source);
};
this.onTab = function(obj) {
  var name = String(obj.id || "").replace("btn", "");
  this.showTab(name || "Overview");
};
this.onNavInventoryList = function() { this.gfnNavigate("InventoryList"); };
this.onNavSupplierList = function() { this.gfnNavigate("SupplierList"); };
this.onLogout = function() {
  this.gfnLogout();
};
this.onComingSoon = function() { this.gfnMessage("This section is not part of the inventory requirements."); };
this.onBack = function() { this.gfnNavigate("InventoryList"); };
this.onEdit = function() {
  if (!this.dsProductDetail.rowcount) return;
  var productId = this.dsProductDetail.getColumn(0, "ProductID");
  nexacro.getApplication().editProductId = productId;
  this.gfnPopup("ProductForm", 500, 800, "onProductSaved", { productId: productId });
};
this.onProductSaved = function(serviceId, value) { if (value) this.onLoad(); };
this.onDownload = function() {
  if (!this.dsProductDetail.rowcount) return;
  this.gfnDownload("products/export.csv", "product.csv",
    { search: this.dsProductDetail.getColumn(0, "ProductID") });
};
this.onActivityChanged = function(obj, e) {
  if (e.reason === nexacro.Dataset.REASON_ASSIGN || e.reason === nexacro.Dataset.REASON_APPEND ||
      e.reason === nexacro.Dataset.REASON_MERGE) this.activityLoaded = true;
};
]]></Script><Bind><BindItem id="bind0" compid="staName" propid="text" datasetid="dsProductDetail" columnid="ProductName"/><BindItem id="bind1" compid="staId" propid="text" datasetid="dsProductDetail" columnid="ProductIDLabel"/><BindItem id="bind2" compid="staStatus" propid="text" datasetid="dsProductDetail" columnid="Status"/><BindItem id="bind3" compid="staInfo" propid="text" datasetid="dsProductDetail" columnid="OverviewText"/><BindItem id="bind4" compid="staSupplier" propid="text" datasetid="dsProductDetail" columnid="SupplierInfo"/><BindItem id="bind5" compid="staImage" propid="image" datasetid="dsProductDetail" columnid="ImageUrl"/></Bind></Form></FDL>