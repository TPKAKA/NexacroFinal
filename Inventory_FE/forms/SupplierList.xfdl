<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1"><Form id="SupplierList" width="1440" height="960" titletext="SupplierList" onload="onLoad" onsize="onResponsiveSize" scrolltype="vertical" scrollbartype="none none">
<Layouts><Layout width="1440" height="960">
<Static id="staSidebarBg" left="0" top="0" width="280" height="960" text="" cssclass="sidebar"/>
<Static id="staTopbarBg" left="280" top="0" width="1160" height="100" text="" cssclass="topbar"/>
<Static id="staLogoMark" left="36" top="28" width="32" height="42" text="K" cssclass="logoMark"/>
<Static id="staBrand" left="76" top="31" width="170" height="40" text="KANBAN" cssclass="brand"/>
<Static id="staBell" left="1330" top="29" width="35" height="42" text="♧" cssclass="topIcon"/>
<Static id="staAvatar" left="1380" top="30" width="38" height="38" text="●" cssclass="avatar"/>
<Button id="btnDashboard" left="32" top="135" width="218" height="48" text="⌂  Dashboard" cssclass="nav" onclick="onComingSoon"/>
<Button id="btnInventoryList" left="32" top="202" width="218" height="48" text="▧  Inventory" cssclass="nav" onclick="onNavInventoryList"/>
<Button id="btnReports" left="32" top="269" width="218" height="48" text="▥  Reports" cssclass="nav" onclick="onComingSoon"/>
<Button id="btnSupplierList" left="32" top="336" width="218" height="48" text="◎  Suppliers" cssclass="navActive" onclick="onNavSupplierList"/>
<Button id="btnOrders" left="32" top="403" width="218" height="48" text="▤  Orders" cssclass="nav" onclick="onComingSoon"/>
<Button id="btnManageStore" left="32" top="470" width="218" height="48" text="▣  Manage Store" cssclass="nav" onclick="onComingSoon"/>
<Button id="btnSettings" left="32" top="816" width="218" height="48" text="⚙  Settings" cssclass="nav" onclick="onComingSoon"/>
<Button id="btnLogout" left="32" top="882" width="218" height="48" text="⇥  Log Out" cssclass="nav" onclick="onLogout"/>
<Edit id="edtSearch" left="318" top="29" width="318" height="42" cssclass="globalSearch" displaynulltext="Search product, supplier, order"/>
<Button id="btnSearch" left="642" top="29" width="78" height="42" text="Search" cssclass="topSearchButton" onclick="onSearch"/>
<Static id="staSuppliersCard" left="312" top="124" width="1096" height="787" text="" cssclass="card"/>
<Static id="staSuppliersTitle" left="330" top="143" width="400" height="37" text="Suppliers" cssclass="sectionTitle"/>
<Button id="btnAdd" left="1020" top="140" width="130" height="42" text="Add Supplier" cssclass="primary" onclick="onAdd"/>
<Button id="btnFilter" left="1160" top="140" width="105" height="42" text="Columns" cssclass="secondary" onclick="onFilter"/>
<Button id="btnDownload" left="1274" top="140" width="118" height="42" text="Download all" cssclass="secondary" onclick="onDownload"/>
<Grid id="grdSuppliers" binddataset="dsSuppliers" left="330" top="197" width="1062" height="651" cssclass="dataGrid" autofittype="col" selecttype="row" onheadclick="onSort"><Formats><Format id="default"><Columns><Column size="212"/><Column size="201"/><Column size="190"/><Column size="235"/><Column size="179"/><Column size="103"/></Columns><Rows><Row size="44" band="head"/><Row size="48"/></Rows><Band id="head"><Cell col="0" text="Supplier name"/><Cell col="1" text="Product"/><Cell col="2" text="Contact number"/><Cell col="3" text="Email"/><Cell col="4" text="Type"/><Cell col="5" text="On the way"/></Band><Band id="body"><Cell col="0" text="bind:SupplierName"/><Cell col="1" text="bind:Product"/><Cell col="2" text="bind:Contact"/><Cell col="3" text="bind:Email"/><Cell col="4" text="bind:Type" color="expr:Type=='Taking return'?'#29A46B':'#D56B6B'"/><Cell col="5" text="bind:OnTheWay"/></Band></Format></Formats></Grid>
<Button id="btnPrev" left="330" top="865" width="92" height="35" text="Previous" cssclass="secondary" onclick="onPrev"/>
<Static id="staCount" left="805" top="868" width="365" height="28" text="" cssclass="pageLabel"/>
<Button id="btnNext" left="1300" top="865" width="92" height="35" text="Next" cssclass="secondary" onclick="onNext"/>
</Layout></Layouts>
<Objects><Dataset id="dsSuppliers" onrowsetchanged="onSuppliersChanged"><ColumnInfo><Column id="SupplierID" type="STRING" size="1024"/><Column id="SupplierName" type="STRING" size="1024"/><Column id="Product" type="STRING" size="1024"/><Column id="Category" type="STRING" size="1024"/><Column id="BuyingPrice" type="STRING" size="1024"/><Column id="Contact" type="STRING" size="1024"/><Column id="Email" type="STRING" size="1024"/><Column id="Type" type="STRING" size="1024"/><Column id="OnTheWay" type="STRING" size="1024"/><Column id="ImageUrl" type="STRING" size="1024"/></ColumnInfo></Dataset><Dataset id="dsSearch"><ColumnInfo><Column id="Search" type="STRING" size="1024"/><Column id="Type" type="STRING" size="1024"/><Column id="Page" type="STRING" size="1024"/><Column id="PageSize" type="STRING" size="1024"/><Column id="SortField" type="STRING" size="1024"/><Column id="SortOrder" type="STRING" size="1024"/></ColumnInfo></Dataset><Dataset id="dsLogout"><ColumnInfo><Column id="SessionToken" type="STRING" size="1024"/></ColumnInfo></Dataset><Dataset id="dsSupplierSummary" onrowsetchanged="onSupplierSummaryChanged"><ColumnInfo><Column id="TotalSuppliers" type="STRING" size="1024"/></ColumnInfo></Dataset></Objects>
<Script type="xscript5.1"><![CDATA[include "lib::InventoryCommon.xjs";
this.page = 0;
this.pageSize = 12;
this.query = "";
this.typeFilter = "";
this.sortField = "SupplierName";
this.sortOrder = "ASC";
this.onLoad = function() {
  this.onResponsiveSize();
  if (!nexacro.getApplication().sessionToken) return this.gfnNavigate("Login");
  this.refresh();
};
this.onResponsiveSize = function() {
  this.gfnResponsiveSupplierList(this.gfnResponsiveShell("SupplierList", true));
};
this.onNavInventoryList = function() { this.gfnNavigate("InventoryList"); };
this.onNavSupplierList = function() {};
this.onLogout = function() {
  this.gfnLogout();
};
this.onComingSoon = function() { this.gfnMessage("This section is not part of the inventory requirements."); };
this.refresh = function() {
  var row = this.gfnBindRecord(this.dsSearch, {});
  this.dsSearch.setColumn(row, "Search", this.query);
  this.dsSearch.setColumn(row, "Type", this.typeFilter);
  this.dsSearch.setColumn(row, "Page", String(this.page));
  this.dsSearch.setColumn(row, "PageSize", String(this.pageSize));
  this.dsSearch.setColumn(row, "SortField", this.sortField);
  this.dsSearch.setColumn(row, "SortOrder", this.sortOrder);
  this.gfnTransaction("suppliers-search", "suppliers/search", "dsSearch=dsSearch",
    "dsSuppliers=dsSuppliers dsSupplierSummary=dsSupplierSummary", "", "onSuppliersLoaded");
};
this.onSuppliersLoaded = function(serviceId, errorCode, errorMessage) {
  if (errorCode < 0) return this.gfnHandleApiError(errorCode, errorMessage);
  this.refreshPageLabel();
};
this.refreshPageLabel = function() {
  var total = this.dsSupplierSummary.rowcount ? Number(this.dsSupplierSummary.getColumn(0, "TotalSuppliers")) : 0;
  var pages = Math.max(1, Math.ceil(total / this.pageSize));
  this.staCount.set_text(this.getOffsetWidth() < 760 ? (this.page + 1) + "/" + pages + " · " + total :
    total + " suppliers · Page " + (this.page + 1) + " of " + pages);
};
this.onSuppliersChanged = function(obj, e) {
  if (e.reason === nexacro.Dataset.REASON_ASSIGN || e.reason === nexacro.Dataset.REASON_APPEND ||
      e.reason === nexacro.Dataset.REASON_MERGE) this.refreshPageLabel();
};
this.onSupplierSummaryChanged = function(obj, e) {
  if (e.reason === nexacro.Dataset.REASON_ASSIGN || e.reason === nexacro.Dataset.REASON_APPEND ||
      e.reason === nexacro.Dataset.REASON_MERGE) this.refreshPageLabel();
};
this.onSearch = function() {
  this.query = String(this.edtSearch.value || "").toLowerCase();
  this.page = 0;
  this.refresh();
};
this.onFilter = function() {
  this.gfnPopup("ColumnChooser", 360, 480, "onColumnChooserClosed", { pvGrid: this.grdSuppliers });
};
this.onColumnChooserClosed = function(serviceId, value) {};
this.onSort = function(obj, e) {
  var fields = ["SupplierName", "Product", "Contact", "Email", "Type", "OnTheWay"];
  if (!e || e.cell < 0 || !fields[e.cell]) return;
  var field = fields[e.cell];
  this.sortOrder = this.sortField === field && this.sortOrder === "ASC" ? "DESC" : "ASC";
  this.sortField = field;
  this.page = 0;
  this.refresh();
};
this.onPrev = function() { if (this.page > 0) { this.page--; this.refresh(); } };
this.onNext = function() {
  var total = this.dsSupplierSummary.rowcount ? Number(this.dsSupplierSummary.getColumn(0, "TotalSuppliers")) : 0;
  if ((this.page + 1) * this.pageSize < total) { this.page++; this.refresh(); }
};
this.onAdd = function() { this.gfnPopup("SupplierForm", 500, 730, "onSupplierSaved"); };
this.onSupplierSaved = function(serviceId, value) { if (value) this.refresh(); };
this.onDownload = function() {
  this.gfnDownload("suppliers/export.csv", "suppliers.csv", { search: this.query, type: this.typeFilter });
};
]]></Script></Form></FDL>