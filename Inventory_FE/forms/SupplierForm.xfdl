<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1"><Form id="SupplierForm" width="500" height="730" titletext="SupplierForm" onload="onLoad">
<Layouts><Layout width="500" height="730">
<Static id="staFormTitle" left="28" top="23" width="440" height="40" text="New Supplier" cssclass="popupTitle"/>
<Static id="staImageBox" left="140" top="70" width="90" height="84" text="" cssclass="uploadBox"/>
<Static id="staImageGlyph" left="162" top="83" width="48" height="55" text="+" cssclass="uploadGlyph"/>
<Static id="staImage" left="240" top="82" width="220" height="50" text="Drag image here
or Browse image" cssclass="uploadHint"/>
<FileUpload id="uplImage" left="240" top="126" width="218" height="30" cssclass="uploadPicker"/>
<Static id="staSupplierName" left="28" top="185" width="150" height="40" text="Supplier Name" cssclass="modalLabel"/>
<Edit id="edtSupplierName" left="188" top="185" width="280" height="42" cssclass="modalField" displaynulltext="Enter supplier name"/>
<Static id="staProduct" left="28" top="257" width="150" height="40" text="Product" cssclass="modalLabel"/>
<Edit id="edtProduct" left="188" top="257" width="280" height="42" cssclass="modalField" displaynulltext="Enter product"/>
<Static id="staCategory" left="28" top="329" width="150" height="40" text="Category" cssclass="modalLabel"/>
<Combo id="edtCategory" left="188" top="329" width="280" height="42" cssclass="modalField" innerdataset="dsCategory" codecolumn="Code" datacolumn="Label"/>
<Static id="staBuyingPrice" left="28" top="401" width="150" height="40" text="Buying Price" cssclass="modalLabel"/>
<Edit id="edtBuyingPrice" left="188" top="401" width="280" height="42" cssclass="modalField" displaynulltext="Enter buying price"/>
<Static id="staContact" left="28" top="473" width="150" height="40" text="Contact Number" cssclass="modalLabel"/>
<Edit id="edtContact" left="188" top="473" width="280" height="42" cssclass="modalField" displaynulltext="Enter contact number"/>
<Static id="staType" left="28" top="545" width="150" height="40" text="Type" cssclass="modalLabel"/>
<Combo id="edtType" left="188" top="545" width="280" height="42" cssclass="modalField" innerdataset="dsType" codecolumn="Code" datacolumn="Label"/>
<Button id="btnCancel" left="267" top="665" width="94" height="40" text="Discard" cssclass="secondary" onclick="onCancel"/>
<Button id="btnSave" left="370" top="665" width="98" height="40" text="Add Supplier" cssclass="primary" onclick="onSave"/>
</Layout></Layouts>
<Objects><Dataset id="dsCategory"><ColumnInfo><Column id="Code" type="STRING" size="64"/><Column id="Label" type="STRING" size="64"/></ColumnInfo><Rows><Row><Col id="Code">Electronics</Col><Col id="Label">Electronics</Col></Row><Row><Col id="Code">Office</Col><Col id="Label">Office</Col></Row><Row><Col id="Code">Stationery</Col><Col id="Label">Stationery</Col></Row><Row><Col id="Code">Other</Col><Col id="Label">Other</Col></Row></Rows></Dataset><Dataset id="dsType"><ColumnInfo><Column id="Code" type="STRING" size="64"/><Column id="Label" type="STRING" size="64"/></ColumnInfo><Rows><Row><Col id="Code">Taking return</Col><Col id="Label">Taking return</Col></Row><Row><Col id="Code">Not taking return</Col><Col id="Label">Not taking return</Col></Row></Rows></Dataset></Objects>
<Script type="xscript5.1"><![CDATA[include "lib::InventoryCommon.xjs";
this.onLoad=function(){};
this.onCancel=function(){this.close();};
this.onSave=function(){
  var supplier={SupplierID:"SUP"+new Date().getTime(),Email:"",OnTheWay:"0"}; var fields=["SupplierName","Product","Category","BuyingPrice","Contact","Type"];
  for(var i=0;i<fields.length;i++)supplier[fields[i]]=this["edt"+fields[i]].value;
  for(var j=0;j<fields.length;j++)if(this.gfnEmpty(supplier[fields[j]]))return this.gfnMessage(fields[j]+" is required.");
  if(!this.gfnNumber(supplier.BuyingPrice))return this.gfnMessage("Price and on-the-way quantity must be non-negative numbers.");
  if(supplier.Type!="Taking return" && supplier.Type!="Not taking return")return this.gfnMessage("Type must be Taking return or Not taking return.");
  this.close(JSON.stringify(supplier));
};
]]></Script></Form></FDL>