<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1"><Form id="SignUp" width="1440" height="960" titletext="SignUp" onload="onLoad" onsize="onResponsiveSize" scrolltype="vertical" scrollbartype="none none">
<Layouts><Layout width="1440" height="960">
<Static id="staAuthCanvas" left="0" top="0" width="1440" height="960" text="" cssclass="authCanvas"/>
<Static id="staLogoMark" left="320" top="355" width="150" height="160" text="K" cssclass="authLogoMark"/>
<Static id="staBrandLarge" left="270" top="520" width="280" height="65" text="KANBAN" cssclass="authBrand"/>
<Static id="staSmallMark" left="993" top="254" width="48" height="51" text="K" cssclass="smallLogo"/>
<Static id="staTitle" left="825" top="325" width="440" height="55" text="Create an account" cssclass="authTitle"/>
<Static id="staHint" left="825" top="376" width="440" height="28" text="Start your 30-day free trial." cssclass="muted"/>
<Static id="staName" left="825" top="425" width="360" height="23" text="Name*" cssclass="fieldLabel"/>
<Edit id="edtName" left="825" top="453" width="360" height="45" cssclass="field" password="false" displaynulltext="Enter name"/>
<Static id="staEmail" left="825" top="510" width="360" height="23" text="Email*" cssclass="fieldLabel"/>
<Edit id="edtEmail" left="825" top="538" width="360" height="45" cssclass="field" password="false" displaynulltext="Enter email"/>
<Static id="staPassword" left="825" top="595" width="360" height="23" text="Password*" cssclass="fieldLabel"/>
<Edit id="edtPassword" left="825" top="623" width="360" height="45" cssclass="field" password="true" displaynulltext="Enter password"/>
<Static id="staConfirm" left="825" top="710" width="360" height="23" text="Confirm password*" cssclass="fieldLabel"/>
<Edit id="edtConfirm" left="825" top="738" width="360" height="45" cssclass="field" password="true" displaynulltext="Enter confirm password"/>
<Static id="staPasswordHelp" left="825" top="671" width="360" height="18" text="Must be at least 8 characters." cssclass="hint"/>
<Button id="btnCreate" left="825" top="810" width="360" height="46" text="Get started" cssclass="primary" onclick="onCreate"/>
<Static id="staBackHint" left="888" top="869" width="230" height="25" text="Already have an account?" cssclass="muted"/>
<Button id="btnBack" left="1095" top="869" width="85" height="25" text="Log in" cssclass="link" onclick="onBack"/>
</Layout></Layouts>
<Objects><Dataset id="dsSignup" onrowsetchanged="onSignupDatasetChanged"><ColumnInfo><Column id="Name" type="STRING" size="1024"/><Column id="Email" type="STRING" size="1024"/><Column id="Password" type="STRING" size="1024"/><Column id="Confirm" type="STRING" size="1024"/></ColumnInfo></Dataset><Dataset id="dsSession"><ColumnInfo><Column id="UserID" type="STRING" size="1024"/><Column id="Name" type="STRING" size="1024"/><Column id="Email" type="STRING" size="1024"/><Column id="Token" type="STRING" size="1024"/><Column id="ExpiresAt" type="STRING" size="1024"/><Column id="RememberMe" type="STRING" size="1024"/></ColumnInfo></Dataset></Objects>
<Script type="xscript5.1"><![CDATA[include "lib::InventoryCommon.xjs";
this.onLoad = function() {
  this.onResponsiveSize();
  this.gfnBindRecord(this.dsSignup, { Name: "", Email: "", Password: "", Confirm: "" });
};
this.onResponsiveSize = function() { this.gfnResponsiveAuth(true); };
this.onCreate = function() {
  var row = this.dsSignup.rowposition < 0 ? 0 : this.dsSignup.rowposition;
  var name = this.dsSignup.getColumn(row, "Name");
  var email = this.dsSignup.getColumn(row, "Email");
  var password = this.dsSignup.getColumn(row, "Password");
  var confirm = this.dsSignup.getColumn(row, "Confirm");
  if (this.gfnEmpty(name)) return this.gfnMessage("Name is required.");
  if (!this.gfnEmail(email)) return this.gfnMessage("Enter a valid email address.");
  if (this.gfnEmpty(password) || password.length < 8) return this.gfnMessage("Password must have at least 8 characters.");
  if (password !== confirm) return this.gfnMessage("Passwords do not match.");
  this.gfnTransaction("auth-signup", "auth/signup", "dsSignup=dsSignup", "dsSession=dsSession", "", "onSignupResult");
};
this.onSignupResult = function(serviceId, errorCode, errorMessage) {
  if (errorCode < 0 || !this.dsSession.rowcount) return this.gfnHandleApiError(errorCode, errorMessage);
  var app = nexacro.getApplication();
  app.sessionToken = this.dsSession.getColumn(0, "Token");
  app.currentUserName = this.dsSession.getColumn(0, "Name");
  this.gfnNavigate("InventoryList");
};
this.onBack = function() { this.gfnNavigate("Login"); };
this.onSignupDatasetChanged = function(obj, e) {
  if (e.reason === nexacro.Dataset.REASON_CHANGESTATUS) this.signupInputChanged = true;
};
]]></Script><Bind><BindItem id="bind0" compid="edtName" propid="value" datasetid="dsSignup" columnid="Name"/><BindItem id="bind1" compid="edtEmail" propid="value" datasetid="dsSignup" columnid="Email"/><BindItem id="bind2" compid="edtPassword" propid="value" datasetid="dsSignup" columnid="Password"/><BindItem id="bind3" compid="edtConfirm" propid="value" datasetid="dsSignup" columnid="Confirm"/></Bind></Form></FDL>